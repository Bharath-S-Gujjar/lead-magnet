# Environment Configuration Example for Lead Magnet Application
# Copy this file to .env for local development or set these variables in production.
# NEVER commit real secret values to source control.

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=false

# MongoDB Database Configuration
# Production MongoDB Atlas connection string (or fallback local connection string)
MONGO_URI=mongodb://localhost:27017/leadmagnet

# Authentication & JWT Security
# Must be set to a strong, random key in production
JWT_SECRET=your_secure_jwt_secret_key_here

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g., https://admin.yourdomain.com,https://app.yourdomain.com)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Product Seeding Control
AUTO_SEED_PRODUCTS=false

# Communication Provider Selection
# Options: dry_run (default, safe for dev), gmail_smtp (local SMTP email), brevo (HTTP port 443, Render-compatible), resend (HTTP port 443, Render-compatible), whatsapp_business, multi_channel
COMMUNICATION_PROVIDER=dry_run

# Explicit Safety Switch for Live Communication Dispatches
# Set to 'true' only when intentionally executing verified live delivery tests.
# When 'false' (default) or unset, live dispatches in test harnesses are blocked by safeguards.
ALLOW_REAL_DISPATCH=false

# Email Option 1: Gmail SMTP (Works locally on Windows/Mac; blocked on Render Free Tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_username_here
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_from_email_here@gmail.com

# Email Option 2: Brevo HTTP API (100% Free, 300 emails/day, works on Render Free Tier via HTTPS Port 443)
# Sign up free at https://www.brevo.com/ and create an API Key (v3)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_gmail_or_verified_email@gmail.com

# Email Option 3: Resend HTTP API (100% Free, 3,000 emails/month, works on Render Free Tier via HTTPS Port 443)
# Sign up free at https://resend.com/ and create an API Key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# WhatsApp Business API Configuration (Meta Cloud API)
# Setup at https://developers.facebook.com/
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_GRAPH_VERSION=v18.0
WHATSAPP_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here

# WhatsApp Webhook Configuration
# Meta App Secret used for HMAC-SHA256 signature verification (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Verification token used during Meta webhook challenge GET handshake
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
# Publicly reachable HTTPS endpoint for webhook events (e.g. via ngrok or production URL)
WHATSAPP_WEBHOOK_URL=https://your-public-domain.com/api/webhooks/whatsapp
# Template language default
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Meta Pre-Approved WhatsApp Message Templates
# Required for business-initiated outbound conversations outside the 24-hour customer window
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=order_confirmation_v1
WHATSAPP_TEMPLATE_CART_ABANDONMENT=cart_abandonment_recovery_v1
WHATSAPP_TEMPLATE_PRODUCT_PRICE_DROP=product_price_drop_alert_v1
WHATSAPP_TEMPLATE_WISHLIST_REMINDER=wishlist_reminder_v1
WHATSAPP_TEMPLATE_LEAD_QUALIFICATION=lead_welcome_v1
WHATSAPP_TEMPLATE_OPPORTUNITY_CART_ITEM_DISCOUNT=cart_discount_alert_v1
WHATSAPP_TEMPLATE_OPPORTUNITY_WISHLIST_ITEM_DISCOUNT=wishlist_discount_alert_v1
WHATSAPP_TEMPLATE_OPPORTUNITY_SIMILAR_PRODUCT_DISCOUNT=similar_product_discount_v1
WHATSAPP_TEMPLATE_OPPORTUNITY_HOT_TO_WARM_REENGAGEMENT=reengagement_offer_v1

# Opportunity Engine & Background Scheduler Configuration
# In production multi-process deployments (e.g. Gunicorn web workers), set:
#   ENABLE_SCHEDULER=false
# This prevents multiple web workers from redundantly scanning and dispatching jobs.
# Then run the dedicated standalone scheduler daemon in a separate process:
#   python backend/scheduler_service.py
# For single-process local development, ENABLE_SCHEDULER=true runs in-process safely.
ENABLE_SCHEDULER=false
# Distributed lease expiration window in seconds (recovers automatically after worker crash)
SCHEDULER_LOCK_LEASE_SECONDS=300
OPPORTUNITY_PIPELINE_INTERVAL_SECONDS=3600
PRICE_DROP_PIPELINE_INTERVAL_SECONDS=1800
OPPORTUNITY_COOLDOWN_HOURS=24
MARKETING_COOLDOWN_HOURS=72

# MongoDB Database Name (used with MONGO_URI)
MONGO_DB_NAME=leadmagnet
