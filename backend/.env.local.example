# Local Development MongoDB Configuration
# Copy this file to backend/.env for local development when Atlas is unreachable
# due to TLS/network restrictions.  NEVER commit real credentials.
MONGO_URI=mongodb://localhost:27017/leadmagnet
JWT_SECRET=replace_with_a_strong_random_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password
